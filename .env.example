# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional
# GEMINI_MODEL=gemini-3.6-flash
# ACCESS_CODE=choose-a-long-passphrase   # if set, visitors must enter it before using the site
# SECRET_KEY=any-long-random-string      # signs the login cookie (needed when ACCESS_CODE is set)
# MAX_PAGES=10
# MAX_UPLOAD_MB=25
